# cp terraform.tfvars.example terraform.tfvars 후 값 수정 (terraform.tfvars는 커밋하지 않음)
gcp_project_id = "your-gcp-project-id"

# 기본값을 바꿀 때만 주석 해제
# gke_location        = "asia-northeast3-a"
# eks_version         = "1.34"
# deletion_protection = false

# --- 앱 배포 후 DNS Failover 활성화 ---
# enable_dns_failover  = true
# route53_zone_id      = "Z0123456789ABCDEFGHIJ"
# service_domain       = "api.payflow.example.com"
# primary_ingress_ip   = "34.64.x.x"
# standby_alb_dns_name = "k8s-xxxx.ap-northeast-2.elb.amazonaws.com"
# standby_alb_zone_id  = "ZWKZPGTI48KDX"
